# gitlab-custom-login-page
# A tiny reverse proxy that injects one <script> tag into GitLab's sign-in page with sub_filter
# and serves the skin assets. Everything else is passed to GitLab untouched, so it works both
#   * "path mode"  - your ingress / load balancer sends only 3 paths here (see README), and
#   * "front mode" - this container sits in front of GitLab and proxies all traffic.
# ${VARS} are filled from the environment by the nginx image entrypoint (envsubst).

# keep what the outer proxy told us; fall back to our own view when we are the first hop
map $http_x_forwarded_proto $skin_fwd_proto { default $http_x_forwarded_proto; '' $scheme; }
map $http_x_forwarded_port  $skin_fwd_port  { default $http_x_forwarded_port;  '' $server_port; }
map $http_x_real_ip         $skin_real_ip   { default $http_x_real_ip;         '' $remote_addr; }
map $skin_fwd_proto         $skin_fwd_ssl   { default off; https on; }
map $http_upgrade           $skin_connection { default upgrade; '' ''; }

# random blurred "bloom" for the top-right corner of the signed-in UI (one of 6 files per request)
map $request_id $skin_bloom {
    ~^[0-2] 1;  ~^[3-5] 2;  ~^[6-8] 3;  ~^[9ab] 4;  ~^[cd] 5;  default 6;
}

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 0;            # uploads / git push limits stay GitLab's business
    proxy_request_buffering off;
    proxy_buffering off;

    # ---- skin assets --------------------------------------------------------------------
    location = /-/login-skin/healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

    location /-/login-skin/logos/ {    # collected at runtime, see collect-logos
        alias ${LOGOS_DIR}/;
        add_header Cache-Control "no-cache";
    }
    location /-/login-skin/ {
        alias /usr/share/nginx/html/login-skin/;
        add_header Cache-Control "public, max-age=3600";
    }

    # ---- the sign-in page (GET renders it, POST submits the form - both proxied as is) ------
    location = /users/sign_in {
        proxy_pass ${GITLAB_UPSTREAM};
        include /etc/nginx/login-skin-proxy.inc;
        proxy_set_header Accept-Encoding "";      # sub_filter cannot rewrite gzipped bodies
        sub_filter_types text/html;
        sub_filter_once  on;
        sub_filter '</body>' '<script src="/-/login-skin/login-skin.js" data-concept="${SKIN_CONCEPT}" data-layouts="${SKIN_LAYOUTS}" data-count="${SKIN_COUNT}" data-grain="${SKIN_GRAIN}" defer></script></body>';
    }

    # ---- GitLab's own corner picture of the signed-in UI (:root.with-bloom body::before) ------
    # same URL, our image; the hash in the file name changes with GitLab versions, the regex does not care
    location ~ ^/assets/blooms/bloom-side-[0-9a-f]+\.png$ {
        root /usr/share/nginx/html/login-skin/bloom;
        types { } default_type image/webp;
        add_header Cache-Control "no-store";      # a fresh random variant on every page load
        try_files /side-$skin_bloom.webp @gitlab;
    }

    # ---- everything else: transparent pass-through ------------------------------------------
    location / {
        proxy_pass ${GITLAB_UPSTREAM};
        include /etc/nginx/login-skin-proxy.inc;
    }
    location @gitlab {
        proxy_pass ${GITLAB_UPSTREAM};
        include /etc/nginx/login-skin-proxy.inc;
    }
}
